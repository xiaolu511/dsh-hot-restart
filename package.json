{
  "name": "dsh-hot-restart",
  "version": "0.3.14",
  "description": "DSH 热重启插件：窗口里一个固定按钮，点一下关闭并自动重开 DSH，全程没有黑窗口；内置自检系统，出问题点一下就能生成一份可直接定位的诊断报告",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "hot-restart"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "小白向指南.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolu511/dsh-hot-restart.git"
  },
  "homepage": "https://github.com/xiaolu511/dsh-hot-restart#readme",
  "bugs": {
    "url": "https://github.com/xiaolu511/dsh-hot-restart/issues"
  },
  "author": "xiaolu511",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
